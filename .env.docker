# ============================================
# HI-Photonics Docker 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际的 API Key
# ============================================

# ============================================
# LLM 配置 - 百炼云 (Qwen)
# 用于 AI 助手对话和意图解析
# ============================================
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen-plus

# ============================================
# Embedding 配置 - 硅基流动 (Qwen3-Embedding-8B)
# 用于 RAG 文档向量化
# ============================================
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=4096

# ============================================
# Qdrant 向量数据库配置
# 用于 RAG 知识库存储
# ============================================
# Docker 内部服务名称，无需修改
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hi_photonics_knowledge
